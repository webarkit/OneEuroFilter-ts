{
  "name": "@webarkit/oneeurofilter-ts",
  "version": "0.3.0",
  "description": "One euro filter algorithm with typescript support",
  "main": "dist/OneEuroFilter.js",
  "module": "dist/OneEuroFilter.mjs",
  "types": "types/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./types/index.d.mts",
        "default": "./dist/OneEuroFilter.mjs"
      },
      "require": {
        "types": "./types/index.d.ts",
        "default": "./dist/OneEuroFilter.js"
      }
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "scripts": {
    "build-ts": "vite build",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/webarkit/OneEuroFilter-ts"
  },
  "keywords": [
    "one",
    "euro",
    "filter",
    "oef"
  ],
  "author": "Walter Perdan",
  "license": "LGPL-3.0-or-later",
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "6.0.3",
    "vite": "8.3.3",
    "vite-plugin-dts": "^5.1.2",
    "vitest": "5.0.5"
  }
}
